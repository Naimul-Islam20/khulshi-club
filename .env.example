# ─── Where the site gets its data (muktoerp_api) ──────────────────────────────
#
# LIVE / STAGING (Docker, Coolify): do NOT use this file. Set these on the container
# instead — they are written into /config.js at every start, no rebuild needed:
#
#   API_URL=https://api.erp17.com/        # Laravel host (the app adds api/)
#   PORTAL_DOMAIN=                        # leave empty → uses the site's own domain
#
# LOCAL (`bun run dev`): copy this file to `.env` (or `.env.local`) and edit.
# Priority: container /config.js  →  .env.local  →  .env  →  http://localhost:8000/

# Laravel API host
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000/

# Club domain sent as X-Portal-Domain. Must exist in club_portal_registry / club_settings.
# Locally "localhost" matches the seeded CKCL club. To browse live data from your
# machine, set NEXT_PUBLIC_BACKEND_URL to the live API and this to ckclbd.com.
NEXT_PUBLIC_PORTAL_DOMAIN=localhost
